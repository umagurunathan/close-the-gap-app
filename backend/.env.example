# Copy to .env for local use. On Cloud Run these are environment variables, and the secret ones come from Secret Manager.
STORE=firestore             # the app always runs on Firestore; only the tests and CI use "memory", set by themselves
SEED_PATH=seed/seed.json
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLOUD_PROJECT=your-project-id   # Gemini (Vertex AI) is billed to it. Sign in with: gcloud auth application-default login
# AI_ENABLED=true           # overrides [ai] enabled in config/settings.toml (on: Gemini; needs GOOGLE_CLOUD_PROJECT and credentials)

# Firestore. Two areas, never mixed: the demo and the signed-in company.
# FIRESTORE_DATABASE=(default)
# FIRESTORE_PROJECT_ID=your-firestore-project-id   # only when the database is in another project
FIRESTORE_WORKSPACE_ID=company
FIRESTORE_DEMO_WORKSPACE_ID=guest

# Sign in with Google (Firebase Authentication) for the people in the private company directory.
# FIREBASE_AUTH_ENABLED=true
# FIREBASE_PROJECT_ID=your-firebase-project-id
# COMPANY_DIRECTORY=[{"id":"p_example","name":"Example Person","email":"person@example.com","title":"Engineer","department":"Platform","managerId":null}]

# Google Calendar (company area only). Keep the client secret and the key in Secret Manager on Cloud Run.
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CALENDAR_REDIRECT_URI=https://your-cloud-run-url/integrations/google-calendar/callback
# GOOGLE_CALENDAR_LOCAL_DEMO_ONLY=true            # local try only, with a http://localhost:8000/... redirect URI
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEB_APP_URL=http://localhost:5173

# Reminder job (POST /jobs/run-reminders). Only the Cloud Scheduler service account may call it; both must be set,
# or the job refuses every call. Locally, impersonate the scheduler account to test (see backend/README.md).
# RUN_REMINDERS_AUDIENCE=http://localhost:8000/jobs/run-reminders   # on Cloud Run: https://<cloud-run-url>/jobs/run-reminders
# REMINDERS_SCHEDULER_SA=reminder-scheduler@your-project-id.iam.gserviceaccount.com

# Older optional proxy ranker inside the rule-based fallback (not used by the live app)
# LLM_PROVIDER=rules        # rules | vertex
# VERTEX_AI_LOCATION=asia-southeast1
# GEMINI_MODEL=gemini-3.8-flash
