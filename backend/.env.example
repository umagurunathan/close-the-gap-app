# Copy to .env for local use. On Cloud Run these are set as environment variables / secrets instead.
STORE=memory                # memory | firestore
SEED_PATH=seed/seed.json
NOW=2026-10-11T09:00:00Z    # optional fixed "now" for demos and tests; remove to use the real clock
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLOUD_PROJECT=your-project-id   # your Google Cloud project; Gemini (Vertex AI) is billed to it. Sign in with: gcloud auth application-default login
LLM_PROVIDER=rules            # rules | vertex; Vertex calls may incur charges
VERTEX_AI_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=           # from AI Studio, when the real agents are wired in
# Set STORE=firestore and these values to persist data in Cloud Firestore.
# FIRESTORE_DATABASE=(default)
# Set FIRESTORE_PROJECT_ID when Firestore is in a different project than Cloud Run.
# FIRESTORE_PROJECT_ID=your-firestore-project-id
# Workspace records are stored in common collection names and separated by workspaceId.
# Use "company" for authenticated application data; use "guest" for the public demo.
FIRESTORE_WORKSPACE_ID=company
# The hosted global mode switch requires Firebase Authentication and Firestore access in either mode.
# DATA_MODE_SWITCH_ENABLED=true
# DATA_MODE_ADMIN_EMAILS=admin@example.com
# Google Meet transcript import; enable the Google Meet REST API in this Cloud project.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google-meet/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEB_APP_URL=http://localhost:5173
# Local Calendar demo:
# GOOGLE_CALENDAR_LOCAL_DEMO_ONLY=true
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/integrations/google-calendar/callback
# Hosted Calendar uses Firebase-authenticated sign-in and Firestore token storage.
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CALENDAR_REDIRECT_URI=https://your-cloud-run-url/integrations/google-calendar/callback
# Firebase Authentication is optional for local development. When enabled, sign-in email must match
# exactly one individual in the company directory. Verify tokens for this Firebase project.
# FIREBASE_AUTH_ENABLED=true
# FIREBASE_PROJECT_ID=your-firebase-project-id
