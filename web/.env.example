# Where the backend lives. Locally it is on port 8000; on Cloud Run use the service URL.
VITE_API_URL=http://localhost:8000
# Firebase Authentication is opt-in. Obtain these values from the Firebase Console web app config.
VITE_FIREBASE_AUTH_ENABLED=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
